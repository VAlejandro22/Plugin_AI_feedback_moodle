<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/assign/feedback/ai/db" VERSION="20241215" COMMENT="XMLDB file for Moodle mod/assign/feedback/ai"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="assignfeedback_ai_config" COMMENT="Stores AI feedback configuration for assignments">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="assignmentid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID of the assignment"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Whether AI feedback is enabled"/>
        <FIELD NAME="rubricfile" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="File ID of rubric in mdl_files"/>
        <FIELD NAME="rubriccontent" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Extracted content from rubric PDF"/>
        <FIELD NAME="apikey" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Encrypted OpenAI API key"/>
        <FIELD NAME="model" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="gpt-3.5-turbo" SEQUENCE="false" COMMENT="OpenAI model to use"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="assignmentid" TYPE="foreign-unique" FIELDS="assignmentid" REFTABLE="assign" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
