# Configuración de desarrollo

## Variables de entorno opcionales

# Copiar este archivo a .env y configurar según necesidades

# Configuración de Moodle
MOODLE_URL=http://localhost:8080
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin123!
MOODLE_ADMIN_EMAIL=admin@example.com

# Configuración de Base de Datos
MYSQL_ROOT_PASSWORD=moodlerootpass
MYSQL_DATABASE=moodle
MYSQL_USER=moodleuser
MYSQL_PASSWORD=moodlepass

# Configuración de OpenAI (opcional)
# Descomentar y configurar si quieres pre-configurar la API key
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Puerto de Moodle
MOODLE_PORT=8080

# Puerto de Base de Datos (exponer solo si es necesario)
# MYSQL_PORT=3306
